# GRAIL API Configuration
# Copy this file to .env.local and update with your actual values

# GRAIL API credentials (get from Oro Finance)
GRAIL_API_KEY=your_grail_api_key_here
GRAIL_API_URL=https://api.grail.oro.io/v1

# Mock mode (set to false when using real API)
GRAIL_MOCK_MODE=true

# Gold price for mock calculations (USD per gram)
GRAIL_MOCK_GOLD_PRICE_USD=65.00

# Supabase (for persistent goal storage)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
